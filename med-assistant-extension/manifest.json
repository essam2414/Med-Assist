{
  "manifest_version": 3,
  "name": "Med Assist",
  "description": "Live AI insights companion for active medical consultations.",
  "version": "1.0.0",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Med Assist — Live Insights"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}