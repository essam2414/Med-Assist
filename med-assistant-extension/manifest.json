{
  "manifest_version": 3,
  "name": "Med Consult AI Assistant (PoC)",
  "description": "Side panel + tab audio capture for online medical consultations.",
  "version": "0.2.0",
  "permissions": [
    "sidePanel",
    "tabCapture",
    "tabs",
    "activeTab",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Med Consult Assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html"
}