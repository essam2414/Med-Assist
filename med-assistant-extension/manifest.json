{
  "manifest_version": 3,
  "name": "Med Assist",
  "description": "Tab audio capture for online medical consultations.",
  "version": "0.2.1",
  "permissions": [
    "sidePanel",
    "tabCapture",
    "tabs",
    "activeTab",
    "cookies",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Med Assist"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}